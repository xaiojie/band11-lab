<script>
import storage from '@system.storage'
import router from '@system.router'

export default {
  data: {
    tip: ''
  },

  choose(clip) {
    storage.set({ key: 'frog_play', value: clip })
    router.back()
  },

  pickIdle() { this.choose('idle') },
  pickLaugh() { this.choose('laugh') },
  pickListen() { this.choose('listen') },
  pickLie() { this.choose('lie') },

  back() {
    router.back()
  }
}
