<template>
  <div class="page">
    <div class="top">
      <text class="clock">{{clock}}</text>
      <text class="date">{{dateText}}</text>
    </div>

    <div class="bubble">
      <text class="bubble-t">{{bubble}}</text>
    </div>

    <div class="stage" onclick="tapPet" onlongpress="longPet">
      <image class="pet" src="{{frameSrc}}" style="height: {{petH}}px;"></image>
    </div>

    <div class="bond">
      <div class="bond-row">
        <text class="bond-l">亲密度</text>
        <text class="bond-v">Lv.{{lv}} · {{intimacy}}</text>
      </div>
      <div class="bar">
        <div class="bar-fill" style="width: {{bondW}}px"></div>
      </div>
    </div>

    <div class="grid">
      <div class="btn-row">
        <div class="btn" onclick="act('pat')"><text class="btn-t">摸摸</text></div>
        <div class="btn" onclick="act('eat')"><text class="btn-t">零食</text></div>
        <div class="btn" onclick="act('sleep')"><text class="btn-t">睡觉</text></div>
      </div>
      <div class="btn-row">
        <div class="btn" onclick="act('token')"><text class="btn-t">喂Token</text></div>
        <div class="btn" onclick="act('code')"><text class="btn-t">码代码</text></div>
        <div class="btn" onclick="act('yawn')"><text class="btn-t">伸懒腰</text></div>
      </div>
    </div>

    <text class="tip">{{tip}}</text>
  </div>
</template>

<style>
  .page {
    width: 212px;
    height: 520px;
    background-color: #080E1A;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding-top: 6px;
    padding-bottom: 6px;
  }
  .top {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .clock {
    font-size: 28px;
    color: #E8F6FF;
  }
  .date {
    font-size: 11px;
    color: #7BA0BE;
    margin-top: 2px;
  }
  .bubble {
    width: 190px;
    height: 46px;
    margin-top: 8px;
    border-radius: 14px;
    background-color: #0E1E33;
    border-width: 1px;
    border-color: #1B3B5A;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-left: 8px;
    padding-right: 8px;
    box-sizing: border-box;
  }
  .bubble-t {
    font-size: 12px;
    color: #CDE6F7;
    text-align: center;
  }
  .stage {
    width: 212px;
    height: 209px;
    margin-top: 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .pet {
    width: 170px;
    height: 209px;
  }
  .bond {
    width: 190px;
    margin-top: 4px;
  }
  .bond-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
  .bond-l {
    font-size: 11px;
    color: #7BA0BE;
  }
  .bond-v {
    font-size: 11px;
    color: #5AC8FF;
  }
  .bar {
    width: 190px;
    height: 5px;
    margin-top: 4px;
    border-radius: 3px;
    background-color: #13273D;
  }
  .bar-fill {
    height: 5px;
    width: 20px;
    border-radius: 3px;
    background-color: #5AC8FF;
  }
  .grid {
    width: 196px;
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .btn-row {
    width: 196px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .btn {
    width: 61px;
    height: 32px;
    border-radius: 16px;
    background-color: #0E1E33;
    border-width: 1px;
    border-color: #1B3B5A;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .btn-t {
    font-size: 12px;
    color: #CDE6F7;
  }
  .tip {
    margin-top: 6px;
    font-size: 9px;
    color: #5C7E97;
  }
</style>

<script>
import storage from '@system.storage'
import vibrator from '@system.vibrator'

var CLIPS = {
  idle:   { n: 24, fps: 8,  loop: true , h: 209 },
  happy:  { n: 14, fps: 12, loop: false , h: 209 },
  shy:    { n: 14, fps: 12, loop: false , h: 209 },
  pat:    { n: 14, fps: 12, loop: false , h: 209 },
  eat:    { n: 18, fps: 10, loop: false , h: 209 },
  sleep:  { n: 20, fps: 8,  loop: true , h: 209 },
  token:  { n: 18, fps: 10, loop: false , h: 143 },
  code:   { n: 18, fps: 10, loop: false , h: 209 },
  yawn:   { n: 20, fps: 10, loop: false , h: 209 },
  brush:  { n: 20, fps: 10, loop: false , h: 209 },
  stretch:{ n: 20, fps: 10, loop: false },
  wake:   { n: 18, fps: 10, loop: false , h: 209 },
  shock:  { n: 18, fps: 10, loop: false , h: 209 },
  dance1: { n: 24, fps: 10, loop: false , h: 209 },
  dance2: { n: 24, fps: 10, loop: false , h: 209 },
  cat:    { n: 20, fps: 10, loop: false , h: 209 },
  rubik:  { n: 20, fps: 10, loop: false , h: 209 },
  whale:  { n: 24, fps: 10, loop: false , h: 148 }
}

var LINES = {
  idle: [
    '今天也要照顾好自己呀',
    '记得喝水哦～',
    '眼睛累了就看看远处',
    '我在这儿陪着你',
    '坐久了站起来走两步吧'
  ],
  pat: ['嘿嘿，舒服～', '再摸一下就充电啦', '你的手好暖', '蹭蹭你'],
  eat: ['好吃！谢谢投喂～', '我们一起吃吧', '吃饱才有力气'],
  token: ['Token 收到！脑子转得更快了', '吃饱 AI 饭，效率翻倍', '再多喂点，我能想更久'],
  code: ['在帮你写代码呢…', '这个 bug 马上就好', '别急，我先想想'],
  yawn: ['困了…你也要早点睡', '打个哈欠，一起休息吧'],
  sleep: ['晚安，做个好梦', '我守着你的梦'],
  brush: ['早呀！刷完牙精神多了', '新的一天，从洗漱开始'],
  stretch: ['伸个懒腰，一起动一动吧', '坐太久了，起来走走'],
  wake: ['刚刚差点睡着…吓我一跳', '被你抓到我打瞌睡啦'],
  shock: ['别戳啦！痒～', '哎呀，冷静点嘛'],
  dance1: ['升级啦！给你跳个舞～', 'Lv.5 解锁：女仆舞'],
  dance2: ['Lv.10！摇摆舞献给你', '看我跳得好不好～'],
  cat: ['撸猫时间到～', '呼噜呼噜…好舒服'],
  rubik: ['我先把魔方拼完…', '再等我一下，差一面了'],
  whale: ['蓝鲸现世！送你一条鲸鱼', '看，整片海都亮起来了'],
  tooMuch: ['今天吃太多啦，明天再喂～']
}

var WEEK = ['日', '一', '二', '三', '四', '五', '六']
var IDLE_VARIANTS = ['cat', 'rubik', 'stretch', 'yawn']

export default {
  data: {
    clock: '--:--',
    dateText: '',
    bubble: '今天也要照顾好自己呀',
    frameSrc: '/assets/pet/idle/f_000.png',
    petH: 209,
    lv: 1,
    intimacy: 0,
    bondW: 8,
    tip: ''
  },

  onInit() {
    this.frame = 0
    this.timer = null
    this.clockTimer = null
    this.current = 'idle'
    this.idleLoops = 0
    this.tapCount = 0
    this.lastTap = 0
    this.fedToday = 0
    this.patToday = 0
    this.today = ''
    this.sleeping = false
    this.bubbleLocked = false
    this.loadState()
    this.tickClock()
    this.clockTimer = setInterval(() => {
      this.tickClock()
    }, 15000)
    this.boot()
  },

  onDestroy() {
    if (this.timer) clearInterval(this.timer)
    if (this.clockTimer) clearInterval(this.clockTimer)
  },

  onHide() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  onShow() {
    this.play(this.sleeping ? 'sleep' : 'idle')
  },

  boot() {
    var h = new Date().getHours()
    if (h >= 23 || h < 6) {
      this.sleeping = true
      this.bubble = '这么晚啦，早点休息哦'
      this.play('sleep')
    } else if (h >= 6 && h < 10) {
      this.bubble = LINES.brush[0]
      this.play('brush')
    } else {
      this.play('idle')
    }
  },

  tickClock() {
    var d = new Date()
    var hh = d.getHours()
    var mm = d.getMinutes()
    var t = (hh < 10 ? '0' + hh : '' + hh) + ':' + (mm < 10 ? '0' + mm : '' + mm)
    var ds = (d.getMonth() + 1) + '月' + d.getDate() + '日 周' + WEEK[d.getDay()]
    var dayKey = d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate()
    this.clock = t
    this.dateText = ds
    if (this.today && this.today !== dayKey) {
      this.fedToday = 0
      this.patToday = 0
    }
    this.today = dayKey
    this.tip = '今日摸摸 ' + this.patToday + ' · 喂食 ' + this.fedToday
  },

  framePath(clip, i) {
    var s = '' + i
    while (s.length < 3) s = '0' + s
    return '/assets/pet/' + clip + '/f_' + s + '.png'
  },

  play(clip) {
    var c = CLIPS[clip]
    if (!c) return
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
    this.current = clip
    this.petH = c.h || 209
    this.frame = 0
    this.frameSrc = this.framePath(clip, 0)
    var self = this
    this.timer = setInterval(function () {
      self.frame = self.frame + 1
      if (self.frame >= c.n) {
        if (c.loop) {
          self.frame = 0
          if (clip === 'idle') self.idleLoops = self.idleLoops + 1
        } else {
          clearInterval(self.timer)
          self.timer = null
          self.backToIdle()
          return
        }
      }
      self.frameSrc = self.framePath(clip, self.frame)
    }, Math.round(1000 / c.fps))
  },

  backToIdle() {
    if (this.sleeping) {
      this.play('sleep')
      return
    }
    if (this.idleLoops > 0 && this.idleLoops % 4 === 0 && Math.random() < 0.5) {
      var v = IDLE_VARIANTS[Math.floor(Math.random() * IDLE_VARIANTS.length)]
      this.bubble = this.say(v)
      this.bubbleLocked = true
      this.play(v)
      this.idleLoops = this.idleLoops + 1
      return
    }
    this.play('idle')
    if (!this.bubbleLocked) this.bubble = this.say('idle')
    this.bubbleLocked = false
  },

  say(kind) {
    var arr = LINES[kind]
    if (!arr) return this.bubble
    return arr[Math.floor(Math.random() * arr.length)]
  },

  buzz(mode) {
    try {
      vibrator.vibrate({ mode: mode || 'short' })
    } catch (e) {
      console.log('vibrate fail', e)
    }
  },

  tapPet() {
    var now = Date.now()
    if (now - this.lastTap < 900) {
      this.tapCount = this.tapCount + 1
    } else {
      this.tapCount = 1
    }
    this.lastTap = now
    if (this.tapCount >= 3) {
      this.tapCount = 0
      this.play('shock')
      this.bubble = this.say('shock')
      this.bubbleLocked = true
      this.buzz('long')
      return
    }
    this.act('pat')
  },

  longPet() {
    if (this.sleeping) this.sleeping = false
    this.play('cat')
    this.bubble = this.say('cat')
    this.bubbleLocked = true
    this.buzz('short')
    this.addBond(2)
    this.saveState()
  },

  act(kind) {
    this.bubbleLocked = true
    if (kind === 'sleep') {
      this.sleeping = true
      this.bubble = this.say('sleep')
      this.play('sleep')
      this.saveState()
      return
    }
    if (this.sleeping) this.sleeping = false
    this.buzz('short')

    if (kind === 'pat') {
      this.patToday = this.patToday + 1
      if (this.patToday % 15 === 0) {
        this.play('whale')
        this.bubble = this.say('whale')
        this.addBond(5)
        this.tip = '今日摸摸 ' + this.patToday + ' · 喂食 ' + this.fedToday
        this.saveState()
        return
      }
      var r = Math.random()
      var clip = r < 0.4 ? 'pat' : (r < 0.7 ? 'happy' : 'shy')
      this.play(clip)
      this.bubble = this.say(clip === 'shy' ? 'shy' : 'pat')
      this.addBond(1)
    } else if (kind === 'eat') {
      if (this.fedToday >= 5) {
        this.play('eat')
        this.bubble = LINES.tooMuch[0]
      } else {
        this.fedToday = this.fedToday + 1
        this.play('eat')
        this.bubble = this.say('eat')
        this.addBond(3)
      }
    } else if (kind === 'token') {
      this.play('token')
      this.bubble = this.say('token')
      this.addBond(2)
    } else if (kind === 'code') {
      this.play('code')
      this.bubble = this.say('code')
      this.addBond(2)
    } else if (kind === 'yawn') {
      this.play('yawn')
      this.bubble = this.say('yawn')
    }
    this.tip = '今日摸摸 ' + this.patToday + ' · 喂食 ' + this.fedToday
    this.saveState()
  },

  addBond(n) {
    var oldLv = this.lv
    this.intimacy = this.intimacy + n
    this.lv = 1 + Math.floor(this.intimacy / 20)
    var w = Math.round(8 + (this.intimacy % 20) * 9.1)
    this.bondW = w > 190 ? 190 : w
    if (this.lv > oldLv) this.levelUp(this.lv)
  },

  levelUp(lv) {
    var clip = 'happy'
    var line = 'pat'
    if (lv === 5) {
      clip = 'dance1'
      line = 'dance1'
    } else if (lv === 10) {
      clip = 'dance2'
      line = 'dance2'
    }
    this.play(clip)
    this.bubble = this.say(line)
    this.bubbleLocked = true
    this.buzz('long')
  },

  saveState() {
    storage.set({
      key: 'pet_state',
      value: JSON.stringify({
        intimacy: this.intimacy,
        fedToday: this.fedToday,
        patToday: this.patToday,
        today: this.today,
        sleeping: this.sleeping
      })
    })
  },

  loadState() {
    var self = this
    storage.get({
      key: 'pet_state',
      success: function (data) {
        if (!data) return
        try {
          var o = JSON.parse(data)
          self.intimacy = o.intimacy || 0
          self.fedToday = o.fedToday || 0
          self.patToday = o.patToday || 0
          self.sleeping = !!o.sleeping
          self.lv = 1 + Math.floor(self.intimacy / 20)
          var w = Math.round(8 + (self.intimacy % 20) * 9.1)
          self.bondW = w > 190 ? 190 : w
        } catch (e) {
          console.log('state parse fail', e)
        }
      }
    })
  }
}
</script>
